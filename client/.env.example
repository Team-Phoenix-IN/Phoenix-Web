# Discord OAuth Client ID (Vite Client Side)
VITE_DISCORD_CLIENT_ID=your_discord_client_id

# Optional: If you want to load these from environment variables in Vite instead of placeholders:
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_HDEV_API_KEY=your_henrikdev_api_key
VITE_YT_API_KEY=your_youtube_api_key
